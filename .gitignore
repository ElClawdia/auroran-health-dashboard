# Environment variables (contains secrets)
.env
.env.*

# Secrets (API keys)
secrets.yaml
passwords.txt

# Never commit JSON artifacts or secrets
*.json

# Flask session secret key
.flask_secret_key

# Package lock files (track example files like smtp_config.json.example)
package-lock.json

# Python
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Logs
logs/
logs/**
*.log

#Data
apple_health_export/
apple_health_export/*
apple_health_export
backups/
